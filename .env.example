# Load through a secure process manager or node --env-file=.env src/server.js
PORT=8766
AGRO_DEMO_TOKEN=
# At least 32 random characters; server-to-server only
AGRO_OPERATOR_TOKEN=
# Repository-local CommonJS module exporting the documented adapter clients
AGRO_INTEGRATION_MODULE=
AGRO_REAL_PAYMENTS_ENABLED=false
AGRO_PAYMENT_AUTHORIZATION=
# Integer AGRO base units; zero blocks every reward
AGRO_MAX_REWARD_UNITS=0
AGRO_DAILY_LIMIT_UNITS=0
# Provider configuration and credential names must be supplied by ecosystem owners.

# Verified read-only API bases. Set explicitly; never point these at arbitrary viewer URLs.
AGRO_EXPLORER_URL=https://agroland.theagrostore.com/
AGRO_MATRIX_URL=https://matrix.theagrostore.com/
# Optional operator-provisioned session for the existing HumHub tracking API.
# Never copy a production user's cookie into source, browser code or logs.
AGRO_MATRIX_SESSION_COOKIE=
# Only explicitly consented public identifiers may be broadcast. Comma separated.
AGRO_PUBLIC_REPORT_FOLIOS=
AGRO_PUBLIC_TRANSACTION_IDS=
TWITCH_EVENTS_ENABLED=false
TWITCH_EVENTSUB_SECRET=
TWITCH_BROADCASTER_ID=
# Current reader defaults to the broadcaster; a different reader is rejected.
TWITCH_CHAT_READER_ID=
# Legacy verifier fields below do not register the managed chat subscription.
TWITCH_SUBSCRIPTION_IDS=
TWITCH_TOKEN_REFRESH_ENABLED=false
AGRO_PUBLIC_WALLET_URL=https://agrocoin.theagrostore.com/public-wallet/

# OAuth uses the fixed registered HTTPS callback; keep secrets in ignored .env (chmod 600).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Space-delimited Twitch scopes. Empty requests identity authorization only.
TWITCH_OAUTH_SCOPES=
# Temporary browser bootstrap. Enable only after reviewing docs/OAUTH_BOOTSTRAP.md.
TWITCH_OAUTH_BOOTSTRAP_ENABLED=false
TWITCH_OAUTH_PAIRING_ENABLED=false

# Isolated authoritative chess session; presentation routes are separate.
CHESS_SESSION_ENABLED=false
CHESS_SESSION_ID=hackathon

# Stage 4: explicit read-only PUBLIC report ingestion; disabled by default.
# Policy file must be inside this repository, private, and operator-reviewed.
AGRO_PLANET_REPORTS_ENABLED=false
AGRO_PLANET_PUBLIC_REPORTS_FILE=

# Stage 5 read-only judge/editorial routes; no deployed activation.
JUDGE_DEMOS_ENABLED=false
# Local simulator only; ignored by the production-facing bridge.
PLANET_DEMO_ENABLED=false
