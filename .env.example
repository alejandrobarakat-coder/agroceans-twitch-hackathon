# Load through a secure process manager or node --env-file=.env src/server.js
PORT=8766
AGRO_DEMO_TOKEN=
# At least 32 random characters; server-to-server only
AGRO_OPERATOR_TOKEN=
# Repository-local CommonJS module exporting the documented adapter clients
AGRO_INTEGRATION_MODULE=
AGRO_REAL_PAYMENTS_ENABLED=false
AGRO_PAYMENT_AUTHORIZATION=
# Integer AGRO base units; zero blocks every reward
AGRO_MAX_REWARD_UNITS=0
AGRO_DAILY_LIMIT_UNITS=0
# Provider configuration and credential names must be supplied by ecosystem owners.

# Verified read-only API bases. Set explicitly; never point these at arbitrary viewer URLs.
AGRO_EXPLORER_URL=https://agroland.theagrostore.com/
AGRO_MATRIX_URL=https://matrix.theagrostore.com/
# Optional operator-provisioned session for the existing HumHub tracking API.
# Never copy a production user's cookie into source, browser code or logs.
AGRO_MATRIX_SESSION_COOKIE=
# Only explicitly consented public identifiers may be broadcast. Comma separated.
AGRO_PUBLIC_REPORT_FOLIOS=
AGRO_PUBLIC_TRANSACTION_IDS=
TWITCH_EVENTS_ENABLED=false
TWITCH_EVENTSUB_SECRET=
TWITCH_BROADCASTER_ID=
TWITCH_SUBSCRIPTION_IDS=
AGRO_PUBLIC_WALLET_URL=https://agrocoin.theagrostore.com/public-wallet/
